{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "入境旅游服务标准互认共享资料",
  "type": "object",
  "required": [
    "domain",
    "version",
    "sample_id",
    "actors",
    "facts",
    "constraints",
    "service_items",
    "regions",
    "recognition_levels",
    "standards",
    "certification_bodies",
    "regional_profiles",
    "marks",
    "verification_records",
    "change_events"
  ],
  "properties": {
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 2
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "actors": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "facts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "service_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "regions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "recognition_levels": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "name", "rank"],
        "properties": {
          "id": {
            "enum": ["self-declaration", "third-party-certification", "formal-mutual-recognition"]
          },
          "name": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      }
    },
    "standards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "status": { "enum": ["current", "superseded", "draft"] }
        },
        "additionalProperties": false
      }
    },
    "certification_bodies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "regions", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": { "enum": ["active", "suspended", "exited"] }
        },
        "additionalProperties": false
      }
    },
    "regional_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "region",
          "service_terms",
          "language_versions",
          "evidence_requirements",
          "certification_bodies"
        ],
        "properties": {
          "region": { "type": "string", "minLength": 1 },
          "service_terms": { "type": "string", "minLength": 1 },
          "language_versions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "evidence_requirements": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "certification_bodies": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "marks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "product_id",
          "product_name",
          "supplier",
          "service_items",
          "regions",
          "valid_from",
          "valid_to",
          "recognition_level",
          "standard_version",
          "status"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "product_id": { "type": "string", "minLength": 1 },
          "product_name": { "type": "string", "minLength": 1 },
          "supplier": { "type": "string", "minLength": 1 },
          "service_items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "valid_from": { "type": "string", "format": "date" },
          "valid_to": { "type": "string", "format": "date" },
          "recognition_level": {
            "enum": ["self-declaration", "third-party-certification", "formal-mutual-recognition"]
          },
          "standard_version": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "suspended", "withdrawn"] }
        },
        "additionalProperties": false
      }
    },
    "verification_records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mark_id",
          "kind",
          "certification_body",
          "region",
          "result",
          "covers",
          "date",
          "responsible_party"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "mark_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["self-declaration", "third-party", "on-site"] },
          "certification_body": { "type": ["string", "null"] },
          "region": { "type": "string", "minLength": 1 },
          "result": { "enum": ["declared", "pass", "fail"] },
          "covers": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "date": { "type": "string", "format": "date" },
          "responsible_party": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "change_events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "date"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": {
            "enum": [
              "standard-revised",
              "certification-suspended",
              "spot-check-failed",
              "body-exited",
              "cross-border-revoked"
            ]
          },
          "date": { "type": "string", "format": "date" },
          "standard_version": { "type": "string", "minLength": 1 },
          "certification_body": { "type": "string", "minLength": 1 },
          "mark_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "regions": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "note": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
